<mxfile host="draw.io" modified="2026-10-08T16:15:00.000Z" agent="draw.io" type="device" version="24.0.0">
  <diagram name="Diagrama de Clases (Usuarios y Entidades)" id="CLASS_DIAGRAM">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- ==================== TÍTULO ==================== -->
        <mxCell id="title" value="&lt;b&gt;Diagrama de Clases — Actores, Entidades y Componentes del Sistema&lt;/b&gt;&lt;br&gt;Sistema de Monitoreo Ambiental para Invernadero — Fase 2 (ETL + OLAP)&lt;br&gt;Semillero COTECTRONIX — COTECNOVA" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="400" y="10" width="700" height="60" as="geometry"/>
        </mxCell>

        <!-- ==================== ACTORES (estereotipo «actor») ==================== -->
        
        <!-- Investigador / Docente -->
        <mxCell id="cls_invest" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;«actor»&lt;/b&gt;&lt;br&gt;&lt;b&gt;Investigador / Docente&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:11px;&quot;&gt;- nombre: String&lt;br&gt;- rol: String = &quot;investigador&quot;&lt;br&gt;- semillero: String&lt;/p&gt;&lt;hr size=&quot;1&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:11px;&quot;&gt;+ consultarAnaliticaOLAP()&lt;br&gt;+ analizarAnomalias()&lt;br&gt;+ evaluarNecesidadRiego()&lt;br&gt;+ compararTratamientos()&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;rounded=1;arcSize=8;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="50" y="100" width="260" height="220" as="geometry"/>
        </mxCell>

        <!-- Administrador de BD -->
        <mxCell id="cls_admin" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;«actor»&lt;/b&gt;&lt;br&gt;&lt;b&gt;Administrador de BD&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:11px;&quot;&gt;- nombre: String&lt;br&gt;- rol: String = &quot;admin_bd&quot;&lt;br&gt;- herramientaBI: String&lt;/p&gt;&lt;hr size=&quot;1&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:11px;&quot;&gt;+ ejecutarETL()&lt;br&gt;+ importarScriptSQL()&lt;br&gt;+ visualizarEsquemaEstrella()&lt;br&gt;+ verificarIntegridad()&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;rounded=1;arcSize=8;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="50" y="380" width="260" height="220" as="geometry"/>
        </mxCell>

        <!-- ==================== COMPONENTE ETL ==================== -->
        <mxCell id="cls_etl" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;«component»&lt;/b&gt;&lt;br&gt;&lt;b&gt;MotorETL (etl_polars.py)&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:11px;&quot;&gt;- csv_path: Path&lt;br&gt;- sensores_meta: Dict&lt;br&gt;- batch_size_dim: int = 250&lt;br&gt;- batch_size_hechos: int = 500&lt;br&gt;- engine: String = &quot;Polars&quot;&lt;/p&gt;&lt;hr size=&quot;1&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:11px;&quot;&gt;+ cargarYLimpiar(): DataFrame&lt;br&gt;+ transformarOLAP(): Tuple&lt;br&gt;+ pivotearVertical(): DataFrame&lt;br&gt;+ calcularAnomalias(): DataFrame&lt;br&gt;+ calcularNecesidadRiego(): DataFrame&lt;br&gt;+ exportarSQL(path): void&lt;br&gt;+ main(): void&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;rounded=1;arcSize=8;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="430" y="100" width="280" height="300" as="geometry"/>
        </mxCell>

        <!-- ==================== MODELO DIMENSIONAL (OLAP) ==================== -->
        
        <!-- dim_tiempo -->
        <mxCell id="cls_dim_tiempo" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;«dimension»&lt;/b&gt;&lt;br&gt;&lt;b&gt;dim_tiempo&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:11px;&quot;&gt;+ id_tiempo: INT «PK»&lt;br&gt;+ fecha_hora: DATETIME&lt;br&gt;+ fecha: DATE&lt;br&gt;+ anio: INT&lt;br&gt;+ mes: INT&lt;br&gt;+ nombre_mes: VARCHAR(20)&lt;br&gt;+ dia: INT&lt;br&gt;+ hora: INT&lt;br&gt;+ franja_horaria: VARCHAR(20)&lt;br&gt;+ dia_semana: VARCHAR(15)&lt;br&gt;+ trimestre: INT&lt;br&gt;+ semana_anio: INT&lt;br&gt;+ es_fin_de_semana: TINYINT&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;rounded=1;arcSize=8;shadow=1;" vertex="1" parent="1">
