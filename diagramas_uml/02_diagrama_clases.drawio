        <!-- fact_mediciones_invernadero (Tabla de Hechos) -->
        <mxCell id="cls_fact" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;«fact table»&lt;/b&gt;&lt;br&gt;&lt;b&gt;fact_mediciones_invernadero&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:11px;&quot;&gt;+ id_medicion: INT «PK» AUTO_INC&lt;br&gt;+ id_sensado_origen: INT&lt;br&gt;+ id_tiempo: INT «FK»&lt;br&gt;+ id_sensor: INT «FK»&lt;br&gt;+ id_surco: INT «FK»&lt;br&gt;+ fecha_hora: DATETIME&lt;br&gt;+ valor_medido: FLOAT&lt;br&gt;+ flag_anomalia: TINYINT(1)&lt;br&gt;+ flag_riego: TINYINT(1)&lt;/p&gt;&lt;hr size=&quot;1&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:4px;font-size:11px;&quot;&gt;&lt;i&gt;31,977 registros&lt;/i&gt;&lt;br&gt;&lt;i&gt;(3,553 capturas × 9 sensores)&lt;/i&gt;&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fillColor=#ffe6cc;strokeColor=#d79b00;rounded=1;arcSize=8;shadow=1;" vertex="1" parent="1">
